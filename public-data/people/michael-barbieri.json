{"ready":true,"data":{"id":"michael-barbieri","name":"Michael Barbieri","birthDate":"2002-01-20","birthPlace":"New York City, New York, USA","bio":"Barbieri was born in New York City and is of Italian descent. He became interested in acting after seeing his brother, John, act in a school play. He gave up baseball to take acting classes. Afterwards, he got into the Lee Strasberg Acting School and soon auditioned for Little Men. His role in the film resulted in him getting signed to WME. He soon began booking roles for major films.","source":"TMDB","fetchedAt":"2026-11-16T12:22:28+00:00","tmdbId":1551547,"sourceUrl":"https://www.themoviedb.org/person/1551547","credits":[{"id":"spider-home","title":"Spider-Man: Homecoming","character":"Charles"}],"photo":"./public-data/images/people/michael-barbieri.webp","filmography":[{"name":"Halloween Ends","year":2022,"character":"Terry","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/q06saepaXeBdkMibuN4R2fXmgIw.jpg"},{"name":"Spider-Man: Homecoming","year":2017,"character":"Charles","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/c24sv2weTHPsmDa7jEMN0m2P3RT.jpg"},{"name":"The Dark Tower","year":2017,"character":"Timmy","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/i9GUSgddIqrroubiLsvvMRYyRy0.jpg"},{"name":"Little Men","year":2016,"character":"Tony Calvelli","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/mMmXSUZ66XoxmT4zdkUkVDdU8Mu.jpg"},{"name":"Killer","year":2016,"character":"Pollack","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/53bybn1yuvZmTtIFWuQ7DOdHcZV.jpg"},{"name":"Khuda Kay Liye","year":2007,"character":"","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/4QaOrupHDRLgWRJEndFKERx9I5y.jpg"}]}}
