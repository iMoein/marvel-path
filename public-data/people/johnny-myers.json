{"ready":true,"data":{"id":"johnny-myers","name":"Johnny Myers","birthDate":"","birthPlace":"","bio":"Johnny Myers is an American-born actor and singer based in the United Kingdom. Originally working as a jazz vocalist, he moved to London in 1970 and transitioned into acting through West End and National Theatre stage productions.\n\nMyers' screen credits include feature films such as Hackers (1995), Laws of Attraction (2004), The Marksman (2005), and Kon-Tiki (2012), along with television projects like Hiroshima (2005) and Sexy Beast (2024). He also portrayed a building manager in the superhero feature Spider-Man: Brand New Day (2026).","source":"TMDB","fetchedAt":"2026-11-19T17:59:42+00:00","tmdbId":1855744,"sourceUrl":"https://www.themoviedb.org/person/1855744","credits":[{"id":"spider-brand","title":"Spider-Man: Brand New Day","character":"Building Manager"}],"photo":"./public-data/images/people/johnny-myers.webp","filmography":[{"name":"Spider-Man: Brand New Day","year":2026,"character":"Building Manager","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/bjiS5ipwxb9JFy3XRRN4OAilSeX.jpg"},{"name":"Kon-Tiki","year":2012,"character":"Committee Member","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/tphF7lJZys5ij9BHivbxsqmPiOo.jpg"},{"name":"Laws of Attraction","year":2004,"character":"Ashton Phelps","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/6aqR0xwmK0mPOIVShDlT88Vo5W0.jpg"},{"name":"Fat Slags","year":2004,"character":"American Journalist","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/ysb1ys1JtBHjDC2CjS06xv74JLD.jpg"},{"name":"Operation Delta Force 4: Deep Fault","year":1999,"character":"Samuels","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/lE47PfI6GjC644TdjsDzhoa1L1L.jpg"},{"name":"Hackers","year":1995,"character":"1st Sysop Technician","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/qfx2EENW1sOpKNVKLzr7VOhlxkt.jpg"},{"name":"Incident in Judaea","year":1991,"character":"",