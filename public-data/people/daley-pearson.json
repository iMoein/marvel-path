{"ready":true,"data":{"id":"daley-pearson","name":"Daley Pearson","birthDate":"","birthPlace":"","bio":"Daley Pearson is a director and the co-founder of the multi-Emmy® Award-winning Ludo Studio.\n\nPearson is a writer, director, producer, and a multi-Emmy® Award-winning creator and co-founder and director at Ludo Studio. Pearson also starred as Thor's roommate, Darryl, with Chris Hemsworth and Jeff Goldblum in Taika Waititi's Team Thor comedy series for Marvel Studios. He created and wrote the concept script for the new horror feature Talk To Me for A24.","source":"TMDB","fetchedAt":"2026-11-16T12:32:04+00:00","tmdbId":1672488,"sourceUrl":"https://www.themoviedb.org/person/1672488","credits":[{"id":"thor-love","title":"Thor: Love and Thunder","character":"Darryl The Tour Guide"}],"photo":"./public-data/images/people/daley-pearson.webp","filmography":[{"name":"Thor: Love and Thunder","year":2022,"character":"Darryl The Tour Guide","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/pIkRyD18kl4FhoCNQuWxWu5cBLM.jpg"},{"name":"Team Darryl","year":2018,"character":"Darryl Jacobson","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/edroTAeTEM9ILyAnumA0ALxRSne.jpg"},{"name":"Bluey","year":2018,"character":"Rocko (voice)","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/9p4pNoGcuyCfHcGWKNrTopqMWtq.jpg"},{"name":"Bluey","year":2018,"character":"Poffertje Dog (voice)","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/9p4pNoGcuyCfHcGWKNrTopqMWtq.jpg"},{"name":"Bluey","year":2018,"character":"Cinema Counter Dog (voice)","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/9p4pNoGcuyCfHcGWKNrTopqMWtq.jpg"},{"name":"Team Thor: Part 2","year":2017,"character":"Darryl Jacobson","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/2jmP71A5Un0jDNqBesDPQSN8hjJ.jpg"},{"name":"Team Thor","year":2016,"character":"Darryl Jacobson","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/hpHvGuMc46pppwpcW0Xk7eys3L4.jpg"}]}}
