85/oZRVDpNtmHk8M1VYy1aeOWUXgbC.jpg"},{"name":"The Good Lie","year":2014,"character":"Dave","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/yAhoeIwwtPxJ7uf9HLIMHIqWFnL.jpg","characterFa":"دیو"},{"name":"Last Shift","year":2014,"character":"John Michael Paymon","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/oSTFMqFpVB4yq9SOIxBp8xZ9jh5.jpg"},{"name":"American Hell","year":2014,"character":"Daemon","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/7CIPS3GIGy5xWHyp1GGYdklrPGQ.jpg"},{"name":"Million Dollar Arm","year":2014,"character":"Delivery Guy","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/6OgA9x6jvwBIj8e7x8LANTbVvR2.jpg"},{"name":"Crackerjack","year":2013,"character":"Clay","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/rSDOBBs4fdBP65hjftu5xYsIgNF.jpg"},{"name":"We're the Millers","year":2013,"character":"Gutter Punk #2","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/qF2LJ0jwWrtXSuT4AFD5OS2IqaT.jpg"},{"name":"Swamp Murders","year":2013,"character":"","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/xmBdPgw9VUYnnqwUPNiKmuKxiiw.jpg"},{"name":"Rectify","year":2013,"character":"Peyton","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/tm9nQe9165cyjnTz8NB50izwcpJ.jpg"},{"name":"No Matter What","year":2011,"character":"Peek","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/nVbyMosoIOMSJ6VEaYikhlr9R97.jpg"},{"name":"The Walking Dead","year":2010,"character":"Jared","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/ng3cMtxYKt1OSQYqFlnKWnVsqNO.jpg"},{"name":"Andy's Spick-N-Span","year":2009,"character":"Dirt Bag","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/7StYF2QcmKGv2pfWggarCcDWeug.jpg"},{"name":"Drop Dead Diva","year":2009,"character":"Randy Flynn","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/fbu2O3hbU1ZROpjU01YCAMLz1sR.jpg"},{"name":"The Vampire Diaries","year":2009,"character":"Patient","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/aBkVgChtyyJaHyZh1gfd8DbzQon.jpg"},{"name":"Kirksdale","year":2007,"character":"Officer Pearl","mediaType":"movie","poster":""}],"nameFa":"جاشوا میکل","bioFa":"جاشوا میکل بازیگر، نمایشنامه نویس و کارگردان موزیک ویدئو از Conyers، GA، و فارغ التحصیل از برنامه های تئاتر و نویسندگی خلاق دانشگاه ایالتی فلوریدا است. زمانی که در FSU بود، به عنوان بازیگر و هنرمند استوری‌برد برای ده‌ها فیلم کوتاه دانشجویی، از نزدیک با مدرسه فیلم تحسین‌شده آنها همکاری کرد. در طول سال‌های کارشناسی و پس از فارغ‌التحصیلی، او به‌عنوان عضو موسس و درامر گروه راک مستقل Look Mexico، تورهای زیادی در ایالات متحده داشت. پس از جدایی از گروه در سال 2010، او به ایالت خود بازگشت تا حرفه ای در سینما و تلویزیون را دنبال کند. او نمایشنامه‌نویسی است که شش بار منتشر شده است، به‌ویژه برای آثارش برای تماشاگران جوان، «شکارچیان هیولا» و «مشکل خوب خوب در جزیره بد بد» شناخته می‌شود. او به‌عنوان کارگردان موزیک ویدیو، ویدیوهایی را برای فیلم‌های Against Me!، Waxahatchee، Jake Bugg، Neon Trees، American Authors، و Fake Problems ساخته و انیمیشن کرده است. او در آتلانتا، جورجیا زندگی می کند، جایی که J. Pervis Talent از او نمایندگی می کند.","birthPlaceFa":"Conyers، جورجیا، ایالات متحده آمریکا"}}
