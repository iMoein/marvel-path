n1R98IK6RiO243kLSwuV.jpg"},{"name":"The Ultimate Fighter","year":2005,"character":"Head Coach","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/8dAOUHYn1R98IK6RiO243kLSwuV.jpg"},{"name":"UFC 48: Payback","year":2004,"character":"Self","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/vMXxBuvE3zY9vpihCB24uGvabwD.jpg"},{"name":"UFC 50: The War of 04","year":2004,"character":"Self","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/5Q4ozAm6X9ehnUVDMhz0KTS46sU.jpg"},{"name":"UFC 46: Supernatural","year":2004,"character":"Self","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/45yP9L3zLjbhQE9izjC1k8r8rSB.jpg"},{"name":"Tout le monde en parle","year":2004,"character":"Self","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/2ij9iqLwm2FMnd6chiX4VvJDiIh.jpg"},{"name":"Sucré salé","year":2002,"character":"Self","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/o4JQcem2uszT5vwrOkQUn1zZ3LH.jpg"},{"name":"Les francs-tireurs","year":1998,"character":"Herself","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/zCCgOtuD6sC3CTaisWtlpX3aEyN.jpg"},{"name":"Kickboxer: Armageddon","year":0,"character":"Kavi","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/zzieYxtIbws8oA0DEwiP9dXVM7T.jpg"}],"nameFa":"ژرژ سنت پیر","bioFa":"ژرژ سنت پیر در 19 می 1981 در سن ایزیدور کبک از خانواده جیم و پائولین سنت پیر به دنیا آمد. سن پیر دوران کودکی سختی را سپری کرد و در مدرسه ای رفت که دیگران لباس و پول او را می دزدیدند. او یادگیری کیوکوشین کاراته را در هفت سالگی نزد پدرش و بعدا از استاد کیوکوشین کاراته شروع کرد تا از خود در برابر یک قلدر مدرسه دفاع کند. او پس از درگذشت معلم کاراته اش، کشتی و جیو جیتسو برزیلی را آغاز کرد و در بوکس نیز آموزش دید. قبل از اینکه به عنوان یک هنرمند رزمی ترکیبی حرفه ای شود، سنت پیر در یک کلوپ شبانه در مونترال در ساحل جنوبی به نام Fuzzy Brossard و به مدت شش ماه به عنوان یک زباله گرد کار می کرد تا هزینه مدرسه خود را بپردازد.\n\nسنت پیر در طول دوران مبارزاتی خود با تعدادی از گروه ها در سالن های ورزشی مختلف تمرین کرده است. قبل از مبارزه با B.J. Penn در UFC 58، او در آکادمی Renzo Gracie Jiu-Jitsu در شهر نیویورک تمرین کرد. سنت پیر کمربند قهوه ای خود را در BJJ در 21 ژوئیه 2006 از رنزو گریسی دریافت کرد. در سپتامبر 2008، سنت پیر کمربند مشکی خود را در جیو جیتسو برزیل زیر نظر برونو فرناندز به دست آورد.","birthPlaceFa":"سنت ایزیدور، کبک، کانادا"}}
