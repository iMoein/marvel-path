://image.tmdb.org/t/p/w185/lX9Ss9LH3bsAoGWDvsPv4zZG9fa.jpg"},{"name":"Person of Interest","year":2011,"character":"Monica Ramirez","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/f8aIvYk5h7Z8EP3dinCmVgQFYow.jpg"},{"name":"All Good Things","year":2010,"character":"Waitress","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/3RM8SyB0yHanJbYeHdgi5eLv21C.jpg","characterFa":"پیشخدمت"},{"name":"Blue Bloods","year":2010,"character":"Angela","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/q1WlrxnCvNhBjJ4N7V0JQXjnIBN.jpg"},{"name":"The Rebound","year":2009,"character":"Teacher at Museum","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/j82RTG8dNyOYhIKspjk5Z0bEmdi.jpg"},{"name":"Marley & Me","year":2008,"character":"OB-GYN Nurse","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/pnB6hjTKylb0Ve2nUWt16gzkErr.jpg"},{"name":"Burn Notice","year":2007,"character":"Ayn","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/o2fnD3SNiQjGVgA2C3ezaeh2HK.jpg"},{"name":"3 lbs","year":2006,"character":"Melania Ortiz","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/ag1BWbuttURLSzJuINPT843HBg0.jpg"},{"name":"CSI: Crime Scene Investigation","year":2000,"character":"Dr. Amy Berkman","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/i5hmoRjHNWady4AtAGICTUXknKH.jpg"},{"name":"Law & Order: Special Victims Unit","year":1999,"character":"Julia Ortiz","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/pHNhUwSXuDQ9jPZOCb8SgJaQZsc.jpg"},{"name":"Law & Order: Special Victims Unit","year":1999,"character":"Annie Colon","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/pHNhUwSXuDQ9jPZOCb8SgJaQZsc.jpg"},{"name":"Law & Order: Special Victims Unit","year":1999,"character":"Dr. Catalina Machado","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/pHNhUwSXuDQ9jPZOCb8SgJaQZsc.jpg"},{"name":"The Sopranos","year":1999,"character":"Clerk","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/rTc7ZXdroqjkKivFPvCPX0Ru7uw.jpg"},{"name":"Law & Order","year":1990,"character":"Amanda Stanley","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/hmd2tEtjolLWpNLCTvXS2PO5VCi.jpg"},{"name":"Law & Order","year":1990,"character":"Lucita","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/hmd2tEtjolLWpNLCTvXS2PO5VCi.jpg"},{"name":"Law & Order","year":1990,"character":"Salma","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/hmd2tEtjolLWpNLCTvXS2PO5VCi.jpg"},{"name":"I Could Really Use You","year":0,"character":"Mama","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/gLTW7ncwfyMe5adEIJGv8g58E0D.jpg"}],"nameFa":"زابرینا گوارا","bioFa":"زابرینا گوارا (زاده ۱۲ ژانویه ۱۹۷۲) یک هنرپیشه اهل ایالات متحده آمریکا است. او برای بازی در نقش ملانیا اورتیز در وزن 3 پوند و سارا اسن در فیلم گاتهام شناخته شده است. گوارا همچنین یک بازیگر تئاتر است و در سال 2013 نقش یازمین را در نمایش Quiara Alegría Hudes برنده جایزه Water by the Spoonful در تئاتر مرحله دوم بازی کرد. او تبار مختلط اسپانیایی و سیاه پوست است.\n\nزابرینا گوارا در 12 ژانویه 1972 به دنیا آمد. اولین نقش او در فیلم قانون و نظم در نقش لوسیتا در سال 1997 بود. همچنین در سال 1997، او در فیلم هتل Manor Inn در نقش دنیز بازی کرد. گوارا سپس در 2 قسمت از قانون و نظم: واحد قربانیان ویژه در سال 2002 و 2005 به ترتیب در نقش آنی کولون و جولیا اورتیز نقش آفرینی کرد. او در سال 2003 دوباره در فیلم قانون و نظم در نقش سلما به عنوان مهمان بازی کرد. در سال 2006، چه گوارا در سریال 3 پوندی در نقش ملانیا اورتیز بازی کرد. در سال 2013، نقش یازمین را در نمایشنامه Quiara Alegría Hudes برنده جایزه آب توسط قاشق در تئاتر مرحله دوم بر عهده گرفت. در سال 2014، او نقش منشی تراسک را در فیلم مردان ایکس: روزهای گذشته آینده به دست آورد. همچنین در سال 2014، چه گوارا نقش سارا اسن را در فیلم Gotham دریافت کرد. او قرار است در برنامه تلویزیونی Daredevil: Born Again استودیو Marvel Disney+ ظاهر شود.\n\nشرح بالا از مقاله ویکی‌پدیا Zabryna Guevara، دارای مجوز تحت CC-BY-SA، فهرست کامل مشارکت‌کنندگان در ویکی‌پدیا.","birthPlaceFa":"شهر نیویورک، نیویورک، ایالات متحده آمریکا","bioFaAttribution":"Description above from the Wikipedia article Zabryna Guevara, licensed under CC-BY-SA, full list of contributors on Wikipedia.","bioFaLicense":"CC-BY-SA"}}
