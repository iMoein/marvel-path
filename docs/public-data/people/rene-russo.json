/w185/iyp1Db5noOA0G5lXK0VezKnDLuR.jpg"},{"name":"Big Trouble","year":2002,"character":"Anna Herk","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/h844gBztdYMLrroUen6qbsomrGx.jpg"},{"name":"Showtime","year":2002,"character":"Chase Renzi","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/8sIooUxXZo2blCVuAYbL2wkdUfD.jpg"},{"name":"The Adventures of Rocky & Bullwinkle","year":2000,"character":"Natasha","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/xCFSsftt2rglC81I6QLWcZSTCBM.jpg"},{"name":"The Thomas Crown Affair","year":1999,"character":"Catherine Banning","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/5yqs1MVlqdIg1DY5adC5jFx3d7j.jpg"},{"name":"The Free Willy Story - Keiko's Journey Home","year":1999,"character":"Narrator","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/wp9HEz7AaBpTtoiZ9slkpsCEuq4.jpg"},{"name":"The Directors","year":1999,"character":"Self","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/rAKg5nCOjYskKgXKYKpwXl1ZUEA.jpg"},{"name":"Lethal Weapon 4","year":1998,"character":"Lorna Cole","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/pTLliHRoG0Qwp6qycmrMB4bD3mr.jpg"},{"name":"Buddy","year":1997,"character":"Trudy Lintz","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/jdKwul2ePJ7vjdlzgxB1mme5S8B.jpg"},{"name":"Ransom","year":1996,"character":"Katherine Mullen","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/4nmOA5ZOY2VlHzwSlKY03sF2JUz.jpg"},{"name":"Tin Cup","year":1996,"character":"Dr. Molly Griswold","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/rB7OvMmjcBFoogleORaUqrRgp8g.jpg"},{"name":"Outbreak","year":1995,"character":"Robby Keough","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/4KymNvlWR0XF0sqX2BWRd9Z3yXR.jpg"},{"name":"Get Shorty","year":1995,"character":"Karen Flores","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/r82SdPhg4fnIcLt0ogIjQxqjdcO.jpg"},{"name":"MADtv","year":1995,"character":"Self","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/4tXHrqYbETym7Def99MeXrpPyRA.jpg"},{"name":"Major League II","year":1994,"character":"Lynn Wells (ucredited)","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/2QAb0gZusyMsZ1W5ce85plVciDp.jpg"},{"name":"In the Line of Fire","year":1993,"character":"Lilly Raines","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/3NvOFpmyECI3DNExYMtFIRcGMsu.jpg"},{"name":"Lethal Weapon 3","year":1992,"character":"Lorna Cole","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/8FnOudDHPOY7MFJnvQMR1qpuyek.jpg"},{"name":"Freejack","year":1992,"character":"Julie Redlund","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/lSN8lIX90Az0t1qvIXC4MlCvd9a.jpg"},{"name":"The Tonight Show with Jay Leno","year":1992,"character":"","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/xAFMZ3wFIEXTISryRZD94AAvWng.jpg"},{"name":"HBO First Look","year":1992,"character":"","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/1R6pR4X5usNA7rPbt9q7a96S6HK.jpg"},{"name":"One Good Cop","year":1991,"character":"Rita Lewis","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/iGhP7xi3Dm7dDgg7JbnQvTPBgYw.jpg"},{"name":"Mr. Destiny","year":1990,"character":"Cindy Jo","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/zlYxDFP9l1YcUnspNzuIa8KVo4N.jpg"},{"name":"Major League","year":1989,"character":"Lynn Wells","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/ypUedY9zX4nGGf1lQv1UGc8PhPA.jpg"},{"name":"Sable","year":1987,"character":"Eden Kendell","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/usrBYRoGnWVauYicMxottXvlOtS.jpg"},{"name":"The Oscars","year":1953,"character":"Self","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/wyMHJMQp8WpmBg9CxefvbQnFhrm.jpg"}],"nameFa":"رنه روسو","bioFa":"رنه ماری روسو (زاده ۱۷ فوریه ۱۹۵۴) بازیگر آمریکایی و مدل سابق است. او کار خود را به عنوان یک مدل مد در دهه 1970 آغاز کرد و روی جلد مجلاتی مانند Vogue و Cosmopolitan ظاهر شد.\n\nاو اولین فیلم خود را در سال 1989 در کمدی Major League انجام داد و در تعدادی از فیلم‌های هیجان‌انگیز و اکشن در طول دهه 1990 به شهرت بین‌المللی رسید، از جمله Lethal Weapon 3 (1992)، In the Line of Fire (1993)، شیوع (1995)، Get Shorty (199om L) 4 (1998) و ماجرای توماس کراون (1999).\n\nپس از سرفصل کمدی خانوادگی «Yous, Mine & Ours» (2005)، روسو پنج سال از بازیگری فاصله گرفت. او در نقش فریگا، مادر قهرمان عنوان، در فیلم ابرقهرمانی ثور (2011)، نقشی که در ثور: دنیای تاریک (2013) و انتقام‌جویان: پایان بازی (2019) تکرار کرد، به سینما بازگشت. در سال 2014، روسو در فیلم جنایی تحسین‌شده Nightcrawler بازی کرد، که برای آن برنده جایزه Saturn برای بهترین بازیگر نقش مکمل زن شد و نامزد جایزه BAFTA برای بهترین بازیگر نقش مکمل شد. او همچنین در فیلم‌های The Intern (2015)، Just Getting Started (2017) و Velvet Buzzsaw (2019) ظاهر شده است.","birthPlaceFa":"بربنک، کالیفرنیا، ایالات متحده آمریکا"}}
