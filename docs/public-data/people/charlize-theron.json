w185/3h4Ys4vzaD59YsD7IIv2f4ZS3rg.jpg"},{"name":"LIVE with Kelly and Mark","year":1988,"character":"Self","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/8eXDNLIhOGSoKCaIw9JJFNbnZ5x.jpg"},{"name":"Goldene Kamera","year":1984,"character":"Self","mediaType":"tv","poster":""},{"name":"Jeopardy!","year":1984,"character":"Self - Clue Presenter","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/11rWvQOEZBouD7wet0sWHwu7NDs.jpg"},{"name":"Entertainment Tonight","year":1981,"character":"Self","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/rVAMCmlyDqhw20NHg5jk9sMuMNg.jpg"},{"name":"Saturday Night Live","year":1975,"character":"Self - Host","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/s1cZBqbMwAF3w8S3Yo0j5nr2Yuo.jpg"},{"name":"The Oscars","year":1953,"character":"Self","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/wyMHJMQp8WpmBg9CxefvbQnFhrm.jpg"},{"name":"The Oscars","year":1953,"character":"Self - Presenter","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/wyMHJMQp8WpmBg9CxefvbQnFhrm.jpg"},{"name":"Today","year":1952,"character":"Self","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/27Sje8LhDZ0J71MuKdr7F8Auc4t.jpg"},{"name":"Bambi","year":1948,"character":"Self","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/7Bc1fE5mKIYmhhgl0fVcw3nvDra.jpg"},{"name":"Jane","year":0,"character":"Jane","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/uxPhyrPtcxmvkNDAUOHktgeBqfD.jpg"},{"name":"Dance Parents","year":0,"character":"","mediaType":"movie","poster":""},{"name":"Mysteria","year":0,"character":"","mediaType":"movie","poster":""},{"name":"Tyrant","year":0,"character":"","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/t5jty6UcriV6WY7TgTyLe4eogeD.jpg"},{"name":"Six Clean Kills","year":0,"character":"","mediaType":"movie","poster":""}],"nameFa":"شارلیز ترون","bioFa":"شارلیز ترون (/ʃɑːrˈliːz ˈθɛrən/ shar-LEEZ THERR-ən؛ آفریقایی: [ʃarˈlis ˈtrɔn]؛ زاده ۷ اوت ۱۹۷۵) یک بازیگر و تهیه کننده اهل آفریقای جنوبی و آمریکایی است. یکی از پردرآمدترین بازیگران زن جهان، جوایز او شامل یک جایزه اسکار و یک جایزه گلدن گلوب، علاوه بر نامزدی برای سه جایزه بفتا و دو جایزه امی است.\n\nترون در دهه 1990 با بازی در نقش بانوی اصلی در فیلم های هالیوودی وکیل مدافع شیطان (1997)، توانا جو یانگ (1998) و قوانین خانه سیدر (1999) به شهرت بین المللی رسید. او برای ایفای نقش قاتل سریالی آیلین وورنوس در هیولا (2003) تحسین منتقدان را دریافت کرد، که برای آن خرس نقره ای و جایزه اسکار بهترین بازیگر زن را دریافت کرد و اولین آفریقای جنوبی بود که برنده اسکار بازیگری شد. او دو بار دیگر برای بازی در نقش یک زن مورد آزار جنسی که به دنبال عدالت است در درام North Country (2005) و مگین کلی در درام بیوگرافی Bombshell (2019) نامزد اسکار شد. او برای بازی در نقش زنان مشکل‌دار در فیلم‌های کمدی-درام «جوان بزرگسال» (2011) و «تالی» (2018) جیسون رایتمن مورد ستایش قرار گرفت.\n\nترون در چندین فیلم اکشن تجاری موفق بازی کرده است، از جمله شغل ایتالیایی (2003)، هنکاک (2008)، پرومتئوس (2012)، مکس دیوانه: جاده خشم (2015)، بلوند اتمی (2017)، و گارد قدیمی (2020)، و همچنین چندین قسمت سریع و خشمگین: The Fate of the Fur (201) و F201 (F201) (2023). در تلویزیون، او برای بازی در نقش بریت اکلند در فیلم زندگی‌نامه‌ای زندگی و مرگ پیتر سلرز (2004) نامزد دریافت جایزه امی پرایم تایم شد.\n\nاز اوایل دهه 2000، ترون با شرکت خود Denver و Delilah Productions وارد تولید فیلم شد. او فیلم‌های متعددی را تولید کرده است که در بسیاری از آنها نقش‌آفرینی داشته است، از جمله دشت سوزان (2008)، مکان‌های تاریک (2015) و لانگ شات (2019). ترون در سال 2007 شهروند آمریکا شد و در عین حال تابعیت آفریقای جنوبی خود را حفظ کرد. در سال 2016، تایم او را به عنوان یکی از 100 فرد تأثیرگذار در جهان معرفی کرد.\n\nشرح بالا از مقاله ویکی‌پدیا شارلیز ترون، با مجوز CC-BY-SA، فهرست کامل مشارکت‌کنندگان در","birthPlaceFa":"بنونی، گوتنگ، آفریقای جنوبی","bioFaAttribution":"Description above from the Wikipedia article Charlize Theron, licensed under CC-BY-SA, full list of contributors on","bioFaLicense":"CC-BY-SA"}}
