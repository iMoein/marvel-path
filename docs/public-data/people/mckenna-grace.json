tps://image.tmdb.org/t/p/w185/52iv1yPKYR4nezoX7lMLcK9yt6q.jpg"},{"name":"Pickle & Peanut","year":2015,"character":"Cindy (voice)","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/eifTkh6JbmEaUTbIm2jaKWr18UQ.jpg"},{"name":"Suburban Gothic","year":2014,"character":"Zelda","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/y3oWzE9jzCNfJ1B1R1ndVVG5Uh9.jpg"},{"name":"Clarence","year":2014,"character":"Tinia (voice)","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/qZkAyOlDAxHtQreQE4ZzGfrSQl8.jpg"},{"name":"R","year":2013,"character":"Riley (Young)","mediaType":"movie","poster":""},{"name":"Goodbye World","year":2013,"character":"Hannah","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/1WEzts5eapNbxglUSNUXUrs98CR.jpg"},{"name":"The Last Leg","year":2013,"character":"Self","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/4euDsPzadRhz0m5CZhQlKcgbZGI.jpg"},{"name":"Instant Mom","year":2013,"character":"Sam","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/8SEtj4Z0KItjFb0BaUgDOvgkIlO.jpg"},{"name":"The Bridge","year":2013,"character":"Girl","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/iV4I9p69BnXo9W3sQYKWwIjmPTh.jpg"},{"name":"The Goodwin Games","year":2013,"character":"Even Younger Chloe","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/nhLk63LAnYCWxEKhKx92iGlFXKa.jpg"},{"name":"Crash & Bernstein","year":2012,"character":"Jasmine Bernstein","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/jE1R5A10reo6T4Qmb6YuGrxyFFn.jpg"},{"name":"Gravity Falls","year":2012,"character":"Additional Voices (voice)","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/qwi3p6PzKfQZ4YXBzv3CP5pO2dE.jpg"},{"name":"Dog with a Blog","year":2012,"character":"Jules","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/3MOm5Yxtm2h4c6ZtBVBhTTNpBn3.jpg"},{"name":"Good Mythical Morning","year":2012,"character":"Self","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/jMpBQr2aNOFAI6wsC47zsOG6qOh.jpg"},{"name":"Once Upon a Time","year":2011,"character":"Young Emma Swan","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/u95scYysMZvBoekSLmMNJjeqXcY.jpg"},{"name":"The Vampire Diaries","year":2009,"character":"Young Caroline","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/aBkVgChtyyJaHyZh1gfd8DbzQon.jpg"},{"name":"CSI: Crime Scene Investigation","year":2000,"character":"Young Abby Fisher","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/i5hmoRjHNWady4AtAGICTUXknKH.jpg"},{"name":"The View","year":1997,"character":"Self - Guest","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/pEUNIxCMh2jFjUj7u09f4O5CcR4.jpg"},{"name":"People's Choice Awards","year":1975,"character":"Self - Presenter","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/ohyiWEGeWUf6JBsgPgtIDKZOJZn.jpg"},{"name":"Straight Lies","year":0,"character":"","mediaType":"movie","poster":""},{"name":"The Nowhere Game","year":0,"character":"Carin","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/gcG05wu0wvQvU3N4dOXNwZgGB4j.jpg"},{"name":"The Official Mistress","year":0,"character":"Comtesse Madeleine de Vascone","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/whcRqwN3y1JsGszfUD7HYGGJndp.jpg"},{"name":"99 Days","year":0,"character":"Molly","mediaType":"movie","poster":""},{"name":"Rabbit Cake","year":0,"character":"","mediaType":"movie","poster":""},{"name":"Untitled Fourth PAW Patrol Film","year":0,"character":"Skye (voice)","mediaType":"movie","poster":""},{"name":"Scooby-Doo: Origins","year":0,"character":"Daphne Blake","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/pm2dMqADFQBQnjFBZS7ez6Tw3IP.jpg"}],"nameFa":"مککنا گریس","bioFa":"مک کنا گریس برگ (زاده ۲۵ ژوئن ۲۰۰۶) یک هنرپیشه و خواننده آمریکایی است. اولین نقش های او شامل جاسمین برنشتاین در کمدی کمدی Disney XD Crash & Bernstein (2012-2014) و فیث نیومن در سریال The Young and the Restless (2013-2015) بود. پس از چندین نقش کوچک، او به عنوان یک کودک نابغه در فیلم با استعداد (2017) ایفای نقش کرد، موفقیتی که به خاطر آن نامزد دریافت جایزه بهترین بازیگر جوان برگزیده منتقدان شد.\n\nگریس برای بازی در نسخه‌های جوان‌تر شخصیت‌ها در فیلم‌های I، Tonya (2017)، The Haunting of Hill House (2018) و Captain Marvel (2019) و برای نقش‌های اصلی‌اش در The Bad Seed (2018)، Troop Zero (2019) و Annabelle Comes Home (2019) شهرت بیشتری کسب کرد. گریس برای بازی در نقش نوجوان آزار دیده استر کیز در The Handmaid's Tale (2021–2022)، نامزد جایزه Primetime Emmy برای بازیگر مهمان برجسته در یک سریال درام شد و او را به اولین فرزندی تبدیل کرد که به عنوان بازیگر مهمان به عنوان امی شناخته شد. او فیبی اسپنگلر را در فیلم‌های کمدی ماوراءالطبیعه Ghostbusters: Afterlife (2021) و Ghostbusters: Frozen Empire (2024) به تصویر کشید که تحسین منتقدان را دریافت کرد و نامزد جایزه فوق‌العاده انتخاب منتقدان شد. در سال 2022، گریس در فیلم The Bad Seed Returns نویسندگی، تهیه کنندگی و بازی در فیلم The Bad Seed Returns بازی کرد و یان بروبرگ را در فیلم A Friend of the Family به تصویر کشید. او سپس در درام عاشقانه Regretting You (2025)، ترسناک فراطبیعی Five Nights at Freddy's 2 (2025) و Slasher Scream 7 (2026) بازی کرد.\n\nپس از امضای قرارداد با Photo Finish Records در سال 2020، گریس اولین تک آهنگ خود، \"Haunted House\" را در سال 2021 به عنوان بخشی از موسیقی متن فیلم Ghostbusters: Afterlife منتشر کرد. او دو نمایشنامه توسعه یافته را در سال 2023 منتشر کرد: Bittersweet 16 و Autumn Leaves که به ترتیب به بررسی صداهای پاپ راک و فولک می پرداختند.\n\nشرح بالا از مقاله ویکی‌پدیا Mckenna Grace، دارای مجوز تحت CC-BY-SA، فهرست کامل مشارکت‌کنندگان در ویکی‌پدیا.","birthPlaceFa":"گریپ وین، تگزاس، ایالات متحده آمریکا","bioFaAttribution":"Description above from the Wikipedia article Mckenna Grace, licensed under CC-BY-SA, full list of contributors on Wikipedia.","bioFaLicense":"CC-BY-SA"}}
