rg/t/p/w185/4w6HuCsL3sagxZ4InzL0ihVBPLK.jpg"},{"name":"Blue Heelers","year":1993,"character":"","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/dxCyxmFSHiAonsb94s1QScyHBAk.jpg"},{"name":"Dead to the World","year":1991,"character":"Pearl Elkington","mediaType":"movie","poster":""},{"name":"Police State","year":1989,"character":"Dawn Parker","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/5wWl9eRYGSAbCN2dyDAK9APDLdW.jpg"},{"name":"The Delinquents","year":1989,"character":"Mrs. Hansen","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/qTjSJTXml4HSzc1N6RvR6ouh21A.jpg"},{"name":"Becca","year":1988,"character":"Emma","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/pzp9p4zJh25ScdsMTiobuiR48eh.jpg"},{"name":"Touch the Sun: Peter & Pompey","year":1988,"character":"Connie Driscoll","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/ct6O3hiDv1ZeQJAcfsj1JSkrCoS.jpg"},{"name":"The Shiralee","year":1988,"character":"Hareema","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/jmScrmvX0pHbugBSlB0IV1s4RMz.jpg"},{"name":"Comrades","year":1987,"character":"Prostitute","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/yrRiCHGYVGkr3xIdZ7Lw0OaYuKv.jpg"},{"name":"The Year My Voice Broke","year":1987,"character":"Anne Olson","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/eThAKG78ypcpyZSysue7exgMuZS.jpg"},{"name":"Bullseye","year":1987,"character":"Dora Mckenzie","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/ja5bx0mH3jjtdKDKrJB7kWWLUUx.jpg"},{"name":"Rafferty's Rules","year":1987,"character":"Dr. Curlewis","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/iWY6s5SilGbn6NyiZsc2j0YTrtx.jpg"},{"name":"The Flying Doctors","year":1986,"character":"Jean Irving","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/Aj4xa7lo9RwTV6DpZ3Pcjgp26Ht.jpg"},{"name":"Bliss","year":1985,"character":"Bettina Joy","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/e2K9Ii2DGDMKKnrD5hLCP7kCtRB.jpg"},{"name":"A Journey to the Center of the Earth","year":1977,"character":"Gräuben (voice)","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/8EnPvCrurqY3SSHjmwreExv2tCw.jpg"},{"name":"Alvin Purple","year":1973,"character":"First Sugar Girl","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/hYvQU6Tv5gD8XcUUDBFR6hFzfB8.jpg"},{"name":"Country Town","year":1973,"character":"Rhoda Wilson","mediaType":"movie","poster":"https://image.tmdb.org/t/p/w185/3XnZlZyRiHt4MRrf9WV0nQJwNXo.jpg"}],"nameFa":"لینت کوران","bioFa":"از ویکی پدیا، دانشنامه آزاد.\n\nLynette Curran یک هنرپیشه استرالیایی است که بیشتر به خاطر بازی در سریال‌ها و فیلم‌های تلویزیونی استرالیایی شناخته می‌شود. بین سال‌های 1967 و 1974 او یکی از اعضای ثابت سریال بلبرد بود. او همچنین در نسخه سینمایی سریال شهر کشور (1971) بازی کرد.\n\nاو بازیگری را در تئاتر در سال 1964 آغاز کرد. کارهای تئاتر شامل همسر کشوری، روکری نوک، ریچارد دوم، فقط بین خودمان، و خاکستر برای شرکت تئاتر ملبورن است. او همچنین در Steaming برای مرکز سیمور در سیدنی بازی کرد. نقش های اولیه فیلم عبارتند از: آلوین پرپل (1973)، کدی (1976)، موج گرما (1982). در اواخر دهه 1970، او حضورهای تلویزیونی بیشتری داشت، از جمله نقش‌هایی در سریال سریال شماره 96 (در سال 1976) و رویه‌های پلیسی Bluey و Cop Shop. کوران یکی از بازیگران سریال سال‌های بی‌قرار (1977-1981) بود که نقش ژان استافورد را بازی می‌کرد. او برای بازی در سریال بهار و پاییز شرکت پخش استرالیایی برنده جایزه سامی شد.\n\nنقش‌های بعدی شامل فیلم‌های داستانی The Delinquents، Somersault و Japanese Story می‌شود. او در تلویزیون نقش برندا جکسون را در سریال Love My Way بازی کرد و در فیلم Underbelly: The Golden Mile بازی کرد.\n\nشرح بالا از مقاله ویکی‌پدیا Lynette Curran، دارای مجوز تحت CC-BY-SA، فهرست کامل مشارکت‌کنندگان در ویکی‌پدیا.​","birthPlaceFa":"استرالیا","bioFaAttribution":"Description above from the Wikipedia article Lynette Curran, licensed under CC-BY-SA, full list of contributors on Wikipedia.​","bioFaLicense":"CC-BY-SA"}}
