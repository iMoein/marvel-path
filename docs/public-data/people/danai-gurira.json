r":"https://image.tmdb.org/t/p/w185/opP6O99cWRZ9tfdPaLsWefbcPRs.jpg"},{"name":"Jimmy Kimmel Live!","year":2003,"character":"Self - Guest","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/bGB6bEbG4qL22C1SFupkdAxYC9i.jpg"},{"name":"Law & Order: Criminal Intent","year":2001,"character":"Marei Rosa Rumbidzai","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/zwqeNcgITL8ixEVVhe1dCnMQksq.jpg"},{"name":"The View","year":1997,"character":"Self - Guest","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/pEUNIxCMh2jFjUj7u09f4O5CcR4.jpg"},{"name":"The Daily Show","year":1996,"character":"Self - Guest","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/ixcfyK7it6FjRM36Te4OdblAq4X.jpg"},{"name":"Law & Order","year":1990,"character":"Courtney Owens","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/hmd2tEtjolLWpNLCTvXS2PO5VCi.jpg"},{"name":"LIVE with Kelly and Mark","year":1988,"character":"Self - Guest","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/8eXDNLIhOGSoKCaIw9JJFNbnZ5x.jpg"},{"name":"The Oscars","year":1953,"character":"Self","mediaType":"tv","poster":"https://image.tmdb.org/t/p/w185/wyMHJMQp8WpmBg9CxefvbQnFhrm.jpg"},{"name":"The Fighting Shirley Chisholm","year":0,"character":"Shirley Chisholm","mediaType":"movie","poster":""}],"nameFa":"دانای گوریرا","bioFa":"دانای جکسای گوریرا (/dəˈnaɪ ɡʊˈrɪərə/؛ زاده ۱۴ فوریه ۱۹۷۸) یک هنرپیشه، نمایشنامه‌نویس و فعال اهل زیمبابوه آمریکایی است. او بیشتر به خاطر ایفای نقش میشون در سریال‌های درام ترسناک AMC، The Walking Dead (2012–2020، 2022) و The Walking Dead: The Ones Who Live (2024) و در نقش Okoye در فیلم‌های ابرقهرمانی دنیای سینمایی مارول، از جمله Black Panther (2018:2020) و Black Panther (2018 Wakan Forever) و فیلم‌های ابرقهرمانی معروف است. گوریرا نویسنده نمایشنامه برادوی Eclipsed است که برای آن نامزد دریافت جایزه تونی بهترین نمایشنامه شد. گوریرا برای بازی در سریال مردگان متحرک دو نامزدی جایزه انتخاب مردم را در سال‌های 2019 و 2020 دریافت کرد و همچنین برای کارش در فیلم مردگان متحرک: آن‌هایی که زنده‌اند نامزد دریافت جایزه تلویزیونی Black Reel در سال 2024 برای نویسندگی برجسته در یک سریال درام شد.\n\nشرح بالا از مقاله ویکی‌پدیا Danai Gurira، دارای مجوز تحت CC-BY-SA، فهرست کامل مشارکت‌کنندگان در ویکی‌پدیا.","birthPlaceFa":"گرینل، آیووا، ایالات متحده آمریکا","bioFaAttribution":"Description above from the Wikipedia article Danai Gurira, licensed under CC-BY-SA, full list of contributors on Wikipedia.","bioFaLicense":"CC-BY-SA"}}
