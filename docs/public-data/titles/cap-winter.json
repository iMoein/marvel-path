 شماره 1"},{"personId":"ed-brubaker","name":"Ed Brubaker","character":"Scientist #2","order":31,"tmdbId":139744,"photo":"./public-data/images/people/ed-brubaker.webp","nameFa":"اد بروبیکر","characterFa":"دانشمند شماره 2"},{"personId":"d-c-pierson","name":"D.C. Pierson","character":"Apple Employee","order":32,"tmdbId":119590,"photo":"./public-data/images/people/d-c-pierson.webp","nameFa":"دی سی پیرسون","characterFa":"کارمند اپل"},{"personId":"danny-pudi","name":"Danny Pudi","character":"Com Tech #1","order":33,"tmdbId":205179,"photo":"./public-data/images/people/danny-pudi.webp","nameFa":"دنی پودی","characterFa":"تکنسین ارتباطات شماره ۱"},{"personId":"bernie-zilinskas","name":"Bernie Zilinskas","character":"Com Tech #2","order":34,"tmdbId":1751774,"photo":"","nameFa":"برنی زیلینسکاس","characterFa":"تکنسین ارتباطات شماره ۲"},{"personId":"branka-kati","name":"Branka Katić","character":"Renata","order":35,"tmdbId":15268,"photo":"./public-data/images/people/branka-kati.webp","nameFa":"برانکا کاتیک","characterFa":"رناتا"},{"personId":"angela-russo-otstot","name":"Angela Russo-Otstot","character":"Garcia","order":36,"tmdbId":1751775,"photo":"./public-data/images/people/angela-russo-otstot.webp","nameFa":"آنجلا روسو اوستوت","characterFa":"گارسیا"},{"personId":"jon-sklaroff","name":"Jon Sklaroff","character":"Charlie XO","order":37,"tmdbId":117190,"photo":"./public-data/images/people/jon-sklaroff.webp","nameFa":"جان اسکلاروف","characterFa":"چارلی ایکس او"},{"personId":"chad-todhunter","name":"Chad Todhunter","character":"Charlie Weapons Tech","order":38,"tmdbId":1216156,"photo":"./public-data/images/people/chad-todhunter.webp","nameFa":"چاد تودهانتر","characterFa":"فن آوری سلاح های چارلی"},{"personId":"abigail-marlowe","name":"Abigail Marlowe","character":"SHIELD Tech","order":39,"tmdbId":179012,"photo":"./public-data/images/people/abigail-marlowe.webp","nameFa":"ابیگیل مارلو","characterFa":"تکنسین شیلد"}],"episodes":[],"overviewFa":"پس از وقایع فاجعه‌بار نیویورک در کنار انتقام‌جویان، استیو راجرز، معروف به کاپیتان آمریکا، زندگی آرامی در واشنگتن دی‌سی دارد و می‌کوشد خود را با دنیای مدرن وفق دهد. اما حمله به یکی از همکارانش در شیلد او را درگیر شبکه‌ای از توطئه‌ها می‌کند که امنیت جهان را به خطر می‌اندازد. کاپیتان آمریکا با همکاری بیوه سیاه تلاش می‌کند ابعاد گسترده‌تر توطئه را آشکار کند و هم‌زمان با قاتلان حرفه‌ای که برای خاموش کردن او فرستاده شده‌اند، بجنگد. وقتی گستره کامل نقشه شرورانه آشکار می‌شود، آن دو از متحد تازه‌ای به نام فالکون کمک می‌گیرند. با این حال، خیلی زود با دشمنی غیرمنتظره و قدرتمند به نام سرباز زمستان روبه‌رو می‌شوند.","taglineFa":"در قهرمانانی که به آنها اعتماد داریم.","directorFa":"جو روسو، آنتونی روسو","genresFa":["اکشن","ماجراجویی","علمی‌تخیلی"]}}
